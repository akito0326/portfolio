# AKITO DEV — バックエンド設定
# このファイルをコピーして .env を作成してください。
# .env は Git 管理対象外です（.gitignore で除外済み）。

# --- PostgreSQL 接続情報 ---
# DB_PORT は docker-compose.yml の公開ポートにも使われる。
# 5432 が既に使用中の場合は 5433 などへ変更する。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=akito_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Optional libpq SSL mode (disable, allow, prefer, require, verify-ca, verify-full).
# Leave unset to retain the current default connection behavior.

# --- アプリケーション ---
# development: エラー詳細をレスポンスに含める / それ以外: 詳細はログのみ
APP_ENV=development

# --- 管理画面ログイン（1ユーザー） ---
# パスワードは平文ではなく password_hash() の結果を書きます。
#   backend/ で実行: php tools/hash-password.php "パスワード"
# 注意: ハッシュには "$" が含まれます（$2y$10$...）。
# docker compose やシェルの変数展開を避けるため、次のどちらかで書いてください。
#   1) シングルクォートで囲む   例: ADMIN_PASSWORD_HASH='$2y$10$...'
#   2) "$" を "$$" にエスケープ  例: ADMIN_PASSWORD_HASH=$$2y$$10$$...
# どちらで書いても読み込み時に "$" へ戻すため、password_verify はどちらの書き方でも通ります。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- Seed が読み込む既存 JSON のディレクトリ（任意） ---
# 未指定の場合は ../src/data（ポートフォリオの既存データ）を読み込みます。
# SEED_DATA_DIR=
